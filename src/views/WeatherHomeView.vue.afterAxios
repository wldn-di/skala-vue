<script setup>
import axios from 'axios'
import { computed, onMounted, ref, watch } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import BaseDashboardCard from '../components/exercise/BaseDashboardCard.vue'
import SearchBar from '../components/exercise/SearchBar.vue'
import WeatherCard from '../components/exercise/WeatherCard.vue'

const router = useRouter()
const route = useRoute()
const weatherList = ref([])
const searchQuery = ref('')
const selectedCityInfo = ref('카드를 클릭하거나 검색해 보세요.')
const isLoading = ref(false)

const cityMapping = [
  { id: 'city_01', regionId: 'seoul', name: '서울' },
  { id: 'city_02', regionId: 'gyeonggi', name: '수원' },
  { id: 'city_03', regionId: 'busan', name: '부산' },
]

const fetchRealTimeWeather = async () => {
  isLoading.value = true
  try {
    const response = await axios.get('/api/weather')
    const weatherByRegion = new Map(response.data.data.map((item) => [item.id, item]))

    weatherList.value = cityMapping.flatMap((city) => {
      const weather = weatherByRegion.get(city.regionId)
      return weather ? [{ id: city.id, name: city.name, temp: weather.temp, status: weather.description }] : []
    })
  } catch {
    weatherList.value = []
  } finally {
    isLoading.value = false
  }
}

onMounted(() => {
  if (route.query.search) searchQuery.value = route.query.search
  fetchRealTimeWeather()
})

watch(searchQuery, (newQuery) => {
  router.push({
    path: route.path,
    query: { search: newQuery || undefined },
  })
})

const filteredWeatherList = computed(() => {
  const query = searchQuery.value.trim()
  if (!query) return weatherList.value
  return weatherList.value.filter((item) => item.name.includes(query))
})

const handleDetailJump = (id) => router.push(`/weather/${id}`)
</script>

<template>
  <div class="dashboard-wrapper">
    <BaseDashboardCard>
      <SearchBar :current-query="searchQuery" @update-query="(value) => (searchQuery = value)" />
    </BaseDashboardCard>

    <BaseDashboardCard>
      <h3>🏙️ 지역별 날씨 현황 (보안 프록시 연동)</h3>
      <p v-if="isLoading" class="loading-message">실시간 기상 데이터를 수신 중입니다...</p>

      <template v-else>
        <WeatherCard v-for="item in filteredWeatherList" :key="item.id" :city-item="item" @select-card="(message) => (selectedCityInfo = message)" @click-detail="handleDetailJump(item.id)" />
        <p v-if="filteredWeatherList.length === 0" class="empty-message">검색 결과와 일치하는 도시가 없습니다.</p>
      </template>
    </BaseDashboardCard>
    <div class="status-bar">{{ selectedCityInfo }}</div>
  </div>
</template>

<style scoped>
.status-bar {
  padding: 10px;
  color: #2e7d32;
  text-align: center;
  background: #e8f5e9;
  border-radius: 6px;
}

.loading-message,
.empty-message {
  padding: 20px 0;
  text-align: center;
}

.loading-message {
  color: #3498db;
}

.empty-message {
  color: #e74c3c;
}
</style>
