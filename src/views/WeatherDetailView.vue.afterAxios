<script setup>
import axios from 'axios'
import { computed, onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'

import { useConfigStore } from '@/stores/configStore'

const route = useRoute()
const router = useRouter()
const configStore = useConfigStore()
const cityData = ref(null)
const isLoading = ref(false)

const cityMapping = {
  city_01: { regionId: 'seoul', korean: '대한민국 서울특별시' },
  city_02: { regionId: 'gyeonggi', korean: '경기도 수원시' },
  city_03: { regionId: 'busan', korean: '부산광역시' },
}

onMounted(async () => {
  const targetCity = cityMapping[route.params.cityId]
  if (!targetCity) return

  isLoading.value = true
  try {
    const response = await axios.get('/api/weather')
    const weather = response.data.data.find((item) => item.id === targetCity.regionId)
    if (!weather) return

    cityData.value = {
      name: targetCity.korean,
      temp: weather.temp,
      status: weather.description,
      humidity: `${weather.humidity}%`,
      wind: `${weather.wind}m/s`,
    }
  } finally {
    isLoading.value = false
  }
})

const displayTemp = computed(() => {
  if (!cityData.value) return 0
  if (configStore.unit === 'fahrenheit') return Math.round((cityData.value.temp * 9) / 5 + 32)
  return cityData.value.temp
})
</script>

<template>
  <div class="detail-container">
    <h3>📊 지역별 상세 기상 관측 정보</h3>
    <hr />
    <p v-if="isLoading">날씨 정보를 동기화하는 중입니다...</p>

    <template v-else>
      <div v-if="cityData" class="info-card">
        <h4>📍 지정 지역: {{ cityData.name }}</h4>
        <p>실시간 기온: {{ displayTemp }}{{ configStore.unitSymbol }}</p>
        <p>기상 현황: {{ cityData.status }}</p>
        <p>대기 습도: {{ cityData.humidity }}</p>
        <p>현재 풍속: {{ cityData.wind }}</p>
      </div>
      <p v-else>해당 지역의 상세 데이터가 없거나 오류가 발생했습니다.</p>
    </template>

    <button class="back-btn" type="button" @click="router.push('/')">← 메인 대시보드로 돌아가기</button>
  </div>
</template>

<style scoped>
.detail-container {
  padding: 20px;
  margin: 0 auto;
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.info-card {
  padding: 15px;
  margin: 15px 0;
  background: #f1f2f6;
  border-radius: 6px;
}

.back-btn {
  padding: 8px 12px;
  color: white;
  cursor: pointer;
  background: #2c3e50;
  border: 0;
  border-radius: 4px;
}
</style>
